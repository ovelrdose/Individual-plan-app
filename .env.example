# Скопируйте в .env и поправьте под свою машину. .env в репозиторий не попадает.

DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Локальный PostgreSQL 16. Роли нужно право CREATEDB — pytest создаёт тестовую базу.
DATABASE_URL=postgres://omr4:omr4@localhost:5432/omr4

TIME_ZONE=Europe/Moscow

# Сессия завершается после стольких часов бездействия.
SESSION_IDLE_HOURS=8

# Сети, из которых открывается публичная шахматка /board/ (через запятую, например 10.0.0.0/8).
# Пусто — доступ свободный (только для локальной разработки). На проде обязательно задать.
PUBLIC_BOARD_NETWORKS=
