# .env рабочего сервера: скопировать в /opt/omr4/app/.env, chmod 600, владелец omr4.
# Подробно — docs/deploy.md, шаг 6.

DEBUG=false
# Сгенерировать: /opt/omr4/venv/bin/python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=заменить-на-длинную-случайную-строку

# Имя сервера (и IP, если по нему тоже заходят) — как в адресной строке браузера.
ALLOWED_HOSTS=omr4.clinic.local
CSRF_TRUSTED_ORIGINS=https://omr4.clinic.local

# Пароль роли omr4 в PostgreSQL (шаг 4). Спецсимволы в пароле кодировать (%40 вместо @).
DATABASE_URL=postgres://omr4:ПАРОЛЬ@localhost:5432/omr4

# Часовой пояс клиники. Системное время сервера — в том же поясе (timedatectl, шаг 1).
TIME_ZONE=Europe/Moscow

SESSION_IDLE_HOURS=8

# Сети клиники, из которых открывается публичное расписание /board/ (через запятую).
PUBLIC_BOARD_NETWORKS=10.0.0.0/8,192.168.0.0/16

# Сервис за nginx: HTTPS и адрес клиента берутся из заголовков nginx.
BEHIND_PROXY=true

# HSTS — только с сертификатом, которому доверяют все компьютеры клиники (например, от CA
# клиники). С самоподписанным оставить 0.
SECURE_HSTS_SECONDS=0

LOG_LEVEL=INFO
